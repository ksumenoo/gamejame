  readyText: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u0430 \u2014 E \u0437\u0430\u0431\u0440\u0430\u0442\u044C, F \u0441\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443"

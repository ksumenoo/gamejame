--- !u!114 &1547649424
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1547649421}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d46da5fb0afc9e4e967f703c7243f19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jam.Gameplay.TutorialHints
  letter: {fileID: 1982923552}
  hand: {fileID: 1613298881}
  portable: {fileID: 2087211663}
  darkroom: {fileID: 1842388921}
  margaret: {fileID: 0}
  inventory: {fileID: 0}
  demoDelay: 1.2
  demoSeconds: 2.5
  tLetter: "\u0421\u0442\u0435\u043A\u043B\u043E \u043F\u043E\u043C\u043D\u0438\u0442 \u044D\u0442\u043E\u0442 \u0434\u043E\u043C \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0435\u0433\u043E \u0445\u043E\u0437\u044F\u0438\u043D."
  tAligned: "\u0412\u043E\u0442. \u041E\u0442\u0441\u044E\u0434\u0430 \u043E\u043D\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432 \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432."
  tDark: "\u0422\u0435\u043C\u043D\u043E. \u041F\u043B\u0430\u0441\u0442\u0438\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438\u2026 \u0430 \u043C\u043D\u0435 \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0438\u0448\u0438\u043D\u044B."
  tLit: "\u0422\u0430\u043A \u043B\u0443\u0447\u0448\u0435. \u041F\u0440\u0438 \u0441\u0432\u0435\u0447\u0430\u0445 \u043E\u043D\u0438 \u0438 \u0441\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u044C."
  tBlank: "\u041F\u0443\u0441\u0442\u043E."
  mFirstSeen: "\u0416\u0435\u043D\u0449\u0438\u043D\u0430\u2026 \u041E\u043D\u0430 \u043D\u0435 \u0438\u0437 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E. \u041E\u043D\u0430 \u0437\u0434\u0435\u0441\u044C \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u0442."
  mLightOut: "\u041E\u043D\u0430 \u0433\u0430\u0441\u0438\u0442 \u0441\u0432\u0435\u0442. \u041E\u043D\u0430 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u043C \u0441\u043D\u0438\u043C\u0430\u043B\u0438."
  mDeath: "\u0425\u043E\u043B\u043E\u0434\u043D\u043E\u2026 \u041E\u043D\u0430 \u0438\u0434\u0451\u0442 \u043D\u0430 \u0448\u0430\u0433\u0438. \u041D\u0430\u0434\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0442\u0438\u0448\u0435."
  s5Seen: "\u0423 \u0441\u0442\u043E\u0439\u043A\u0438 \u2014 \u0435\u0451 \u0442\u0435\u043D\u044C. \u041E\u043D\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0436\u0434\u0451\u0442, \u043A\u043E\u0433\u0434\u0430 \u0435\u0451 \u0441\u043D\u0438\u043C\u0443\u0442."
  s5Posed: "\u041E\u043D\u0430 \u043F\u0440\u0438\u0448\u043B\u0430. \u0421\u0442\u043E\u0438\u0442, \u043A\u0430\u043A \u0442\u043E\u0433\u0434\u0430\u2026 \u043D\u0435 \u0434\u044B\u0448\u0430\u0442\u044C."
  s5Failed: "\u0421\u043C\u0430\u0437\u0430\u043D\u0430. \u042F \u0437\u0430\u043A\u0440\u044B\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0430\u043D\u043E \u2014 \u0430 \u043E\u043D\u0430 \u0441\u0442\u043E\u044F\u043B\u0430 \u0434\u043E \u043A\u043E\u043D\u0446\u0430."
  developed:
  - "\u0412\u0441\u0435 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C. \u0418 \u043E\u0434\u0438\u043D \u0441\u0442\u0443\u043B \u0437\u0430\u0447\u0435\u043C-\u0442\u043E \u043F\u043E\u0432\u0451\u0440\u043D\u0443\u0442 \u043A \u0434\u0432\u0435\u0440\u0438."
  - "\u0422\u0430\u043A\u0438\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0435. \u0421\u043B\u043E\u0432\u043D\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u0435\u0449\u0451 \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C."
  - "\u041E\u043D\u0438 \u0437\u0432\u0430\u043B\u0438 \u043A\u043E\u0433\u043E-\u0442\u043E. \u0418 \u0432\u0441\u0435 \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u0439 \u0441\u0442\u0443\u043B."
  - "\u041E\u043D \u0436\u0436\u0451\u0442 \u043F\u0438\u0441\u044C\u043C\u0430. \u0418\u043B\u0438 \u0441\u043D\u0438\u043C\u043A\u0438. \u0425\u043E\u0442\u0435\u043B \u0447\u0442\u043E-\u0442\u043E \u0437\u0430\u0431\u044B\u0442\u044C."
  - "\u041E\u043D\u0430 \u0441\u0442\u043E\u0438\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u043E\u0432\u043D\u043E. \u0422\u0430\u043A \u0441\u0442\u043E\u044F\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C \u0441\u043D\u0438\u043C\u043A\u0435."
  - "\u0428\u0442\u0430\u0442\u0438\u0432\u2026 \u0441\u0443\u043C\u043A\u0430\u2026 \u042D\u0442\u043E \u0436\u0435 \u043C\u043E\u0439 \u043F\u0438\u0434\u0436\u0430\u043A. \u042D\u0442\u043E \u044F."
  stuckObscura: 60
  stuckObscuraText: "\u0414\u043E\u043C \u043D\u0435 \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u0441\u0435\u0431\u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A. \u041D\u0430\u0434\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u0442\u0435\u043A\u043B\u043E."
  stuckSpot: 90
  stuckSpotText: "\u0421\u043D\u0438\u043C\u043A\u0438 \u0432 \u043F\u0440\u0438\u0445\u043E\u0436\u0435\u0439 \u043A\u0442\u043E-\u0442\u043E \u0443\u0436\u0435 \u0441\u043D\u0438\u043C\u0430\u043B. \u041D\u0430\u0434\u043E \u0432\u0441\u0442\u0430\u0442\u044C \u0442\u0430\u043C \u0436\u0435, \u0433\u0434\u0435 \u0441\u0442\u043E\u044F\u043B \u043E\u043D."
  stuckShutter: 30
  stuckShutterText: "\u0421\u0442\u0430\u0432\u043B\u044E \u0448\u0442\u0430\u0442\u0438\u0432 \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E \u0437\u0430\u0441\u043B\u043E\u043D\u043A\u0443. \u0418 \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u044E, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F \u0432\u044B\u0434\u0435\u0440\u0436\u043A\u0430."
  stuckDevelop: 120
  stuckDevelopText: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u0442\u043E\u0438\u0442, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u0430. \u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u0441\u0432\u0435\u0442 \u2014 \u0442\u0430\u043C \u043F\u0440\u043E\u044F\u0432\u043E\u0447\u043D\u0430\u044F."
  stuckPose: 120
  stuckPoseText: "\u041D\u0430 \u043F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0445 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0430\u0445 \u0436\u0434\u0443\u0442, \u043F\u043E\u043A\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444 \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0437\u0430\u0441\u043B\u043E\u043D\u043A\u0443. \u041E\u043D\u0430 \u0436\u0434\u0451\u0442 \u043C\u0435\u043D\u044F."
  keyObscura: "\u041F\u041A\u041C"
  keyCamera: "F   \xB7   E"
  keyCandle: E

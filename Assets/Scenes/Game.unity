MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1547649421}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a1cb5f49b8507f45942bf12c9e15171, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jam.Gameplay.Act2Director
  player: {fileID: 1613298886}
  interactor: {fileID: 1613298885}
  twist: {fileID: 1547649423}
  photographer: {fileID: 1792725776}
  viewer: {fileID: 1116154675}
  credits: {fileID: 321529526}
  whiteFlash: {fileID: 1187508705}
  meter: {fileID: 75063324}
  finalPlate: {fileID: 2800000, guid: c72b1d0ae4baf274d9df8524a4be6b60, type: 3}
  fillSeconds: 2.5
  decayPerSecond: 0.15
  stillSpeed: 0.25
  thoughtStart: "\u0414\u043E\u043C \u0432\u0438\u0441\u0438\u0442 \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439\u2026 \u042D\u0442\u043E \u044F \u2014 \u043F\u043E \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0441\u0442\u0435\u043A\u043B\u0430."
  thoughtPhotographer: "\u041A\u0442\u043E-\u0442\u043E \u043F\u0440\u0438\u0448\u0451\u043B. \u0421\u043E \u0448\u0442\u0430\u0442\u0438\u0432\u043E\u043C. \u041E\u043D \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0440\u0438 \u0441\u0432\u0435\u0447\u0430\u0445 \u2014 \u043A\u0430\u043A \u044F \u0442\u043E\u0433\u0434\u0430."
  thoughtSeen: "\u0415\u0433\u043E \u043A\u0430\u043C\u0435\u0440\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043C\u0435\u043D\u044F. \u0415\u0441\u043B\u0438 \u0437\u0430\u043C\u0440\u0443 \u2014 \u043F\u0440\u043E\u044F\u0432\u043B\u044E\u0441\u044C \u043D\u0430 \u0435\u0433\u043E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0435."
  thoughtFirstCandle: "\u041E\u0433\u043E\u043D\u044C \u0443\u043C\u0438\u0440\u0430\u0435\u0442 \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u043C\u043D\u043E\u0439. \u041A\u0430\u043A \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0435\u0439."
  thoughtRelit: "\u041E\u043D \u0443\u043F\u0440\u044F\u043C\u044B\u0439. \u042F \u0442\u043E\u0436\u0435 \u0431\u044B\u043B \u0443\u043F\u0440\u044F\u043C\u044B\u043C."
  thoughtDoor: "\u041E\u043D \u0431\u043E\u0438\u0442\u0441\u044F \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u043C\u0430. \u041A\u0430\u043A \u0438 \u044F \u043A\u043E\u0433\u0434\u0430-\u0442\u043E."
  thoughtStuck: "\u041F\u043E\u043A\u0430 \u0433\u043E\u0440\u0438\u0442 \u0441\u0432\u0435\u0442, \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u0441\u043D\u0438\u043C\u0430\u0442\u044C. \u0410 \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u043C\u043D\u043E\u0439 \u043E\u0433\u043E\u043D\u044C \u043D\u0435 \u0436\u0438\u0432\u0451\u0442."
  thoughtFlash: "\u041C\u0430\u0433\u043D\u0438\u0439. \u041A\u0430\u043A \u0443 \u043C\u0435\u043D\u044F \u0442\u043E\u0433\u0434\u0430\u2026 \u041E\u0442 \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u043D\u0435 \u0443\u0431\u0435\u0436\u0430\u0442\u044C \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439."
  doorDemoAfterRelit: 4
  doorDemoFallback: 50
  stuckSeconds: 90
  thoughtRestart: "\u0415\u0449\u0451 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u2014 \u0438 \u044F \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0431\u044B \u043D\u0430 \u0435\u0433\u043E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0435. \u041D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
  thoughtFlee: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0441\u0432\u0435\u0447\u0430. \u0411\u0435\u0433\u0438 \u043E\u0442\u0441\u044E\u0434\u0430. \u0411\u0435\u0433\u0438, \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u0442\u0435\u0431\u044F \u043D\u0435 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u043A \u0441\u0442\u043E\u0439\u043A\u0435."
  thoughtFinale: "\u041E\u043D \u0432\u044B\u0440\u043E\u043D\u0438\u043B \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443. \u041C\u044B \u0432\u0441\u0435 \u043D\u0430 \u043D\u0435\u0439 \u2014 \u0438 \u044F \u0442\u043E\u0436\u0435. \u0420\u0435\u0437\u043A\u0438\u0435. \u041D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0435."

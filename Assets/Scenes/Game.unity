--- !u!114 &2009318848
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2009318846}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d46da5fb0afc9e4e967f703c7243f19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jam.Gameplay.TutorialHints
  letter: {fileID: 1272224021}
  hand: {fileID: 472070694}
  portable: {fileID: 1714539036}
  darkroom: {fileID: 1423706080}
  afterLetter: "\u041F\u041A\u041C \u2014 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u0441\u043A\u0443\u0440\u0443. \u0422\u043E\u043B\u044C\u043A\u043E \u0432 \u043D\u0435\u0439 \u0432\u0438\u0434\u043D\u043E \u043F\u0440\u043E\u0448\u043B\u043E\u0435 \u0434\u043E\u043C\u0430."
  firstRaise: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435 \u043F\u0440\u043E\u0448\u043B\u043E\u0435 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0446\u0435\u043B\u0438\u043A\u043E\u043C. \u0421\u043D\u0438\u043C\u043A\u0438 \u0432 \u043F\u0440\u0438\u0445\u043E\u0436\u0435\u0439 \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0443\u0442, \u043E\u0442\u043A\u0443\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
  firstAligned: "\u0417\u0434\u0435\u0441\u044C. F \u2014 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443, \u0437\u0430\u0442\u0435\u043C \u0434\u0435\u0440\u0436\u0430\u0442\u044C E, \u043F\u043E\u043A\u0430 \u0438\u0434\u0451\u0442 \u0432\u044B\u0434\u0435\u0440\u0436\u043A\u0430."
  firstDeveloped: "\u0421\u043D\u0438\u043C\u043E\u043A \u0437\u0430\u043D\u044F\u043B \u0441\u0432\u043E\u0451 \u043C\u0435\u0441\u0442\u043E \u0432 \u0430\u043B\u044C\u0431\u043E\u043C\u0435 \u0432 \u043F\u0440\u0438\u0445\u043E\u0436\u0435\u0439."
  firstBlank: "\u041D\u0430 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0435 \u043F\u0443\u0441\u0442\u043E. \u0421\u043D\u0438\u043C\u0430\u0442\u044C \u043D\u0443\u0436\u043D\u043E \u0441 \u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430, \u043E\u0442\u043A\u0443\u0434\u0430 \u0432\u0438\u0434\u043D\u043E \u043F\u0440\u043E\u0448\u043B\u043E\u0435 \u0446\u0435\u043B\u0438\u043A\u043E\u043C."
  poseSceneSeen: "\u0423 \u0441\u0442\u043E\u0439\u043A\u0438 \u2014 \u0435\u0451 \u0442\u0435\u043D\u044C. \u041F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u2026 \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D\u0430 \u0436\u0434\u0451\u0442, \u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u043A\u0440\u043E\u044E\u0442 \u0437\u0430\u0441\u043B\u043E\u043D\u043A\u0443."
  posed: "\u041E\u043D\u0430 \u043F\u0440\u0438\u0448\u043B\u0430. \u0421\u0442\u043E\u0438\u0442, \u043A\u0430\u043A \u0442\u043E\u0433\u0434\u0430. \u0422\u043E\u043B\u044C\u043A\u043E \u0431\u044B \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u0437\u0430\u0441\u043B\u043E\u043D\u043A\u0443 \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
  poseFailed: "\u041E\u043D\u0430 \u0441\u043C\u0430\u0437\u0430\u043D\u0430. \u041D\u0430 \u043F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u043E\u043C \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0435 \u0441\u0442\u043E\u044F\u0442 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E \u2014 \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u043E\u043D\u0446\u0430 \u0432\u044B\u0434\u0435\u0440\u0436\u043A\u0438."
